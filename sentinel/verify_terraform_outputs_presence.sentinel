# Verification of Terraform outputs presence
# Ensures that Terraform configurations define at least one output and prevents deployments with no outputs declared.

import "tfconfig/v2" as tfconfig

has_outputs = func() {
	outputs = tfconfig.outputs else {}
	if length(outputs) > 0 {
		return true
	}
	return false
}

main = rule {
	has_outputs()
}
