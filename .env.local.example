# ==============================================================================
# Local Environment Configuration Example
# Copy this file to .env and fill in values
# ==============================================================================

# --- Release / Versioning --- #
export MOD_RELEASE="0.0.0" #semver:major.minor.patch

# --- Azure Subscription & Authentication --- #
export ARM_SUBSCRIPTION_ID="3ce37cfd-e614-4570-8d11-015256bd51a4"
export ARM_TENANT_ID="237fbc04-c52a-458b-af97-eaf7157c0cd4"
# export ARM_CLIENT_ID="<your-azure-client-id>"
# export ARM_CLIENT_SECRET="<your-azure-client-secret>"

# --- Terraform Input Variables (TF_VAR_*) --- #
export TF_VAR_windows_bastion_admin_password="<your-complex-bastion-password>"
# export TF_VAR_event_hub_connection_string="<your-event-hub-connection-string>"

# --- Deployment Scripts Configuration --- #
export SSH_KEY="${HOME}/.ssh/id_ed25519"
export TUNNEL_PORT="2222"
