# ==============================================================================
# Local Environment Configuration Example
# Copy this file to .env and fill in values
# ==============================================================================

# --- Release / Versioning --- #
export MOD_RELEASE="0.0.0" #semver:major.minor.patch

# --- Azure Subscription & Authentication --- #
export ARM_SUBSCRIPTION_ID="<your-azure-subscription-id>"  # az account show --query id -o tsv
export ARM_TENANT_ID="<your-azure-tenant-id>"              # az account show --query tenantId -o tsv
# export ARM_CLIENT_ID="<your-azure-client-id>"
# export ARM_CLIENT_SECRET="<your-azure-client-secret>"

# --- Terraform Input Variables (TF_VAR_*) --- #
export TF_VAR_ubuntu_bastion_admin_password="<your-complex-ubuntu-bastion-password>"
# export TF_VAR_event_hub_connection_string="<your-event-hub-connection-string>"

# --- Deployment Scripts Configuration --- #
export SSH_KEY="${HOME}/.ssh/xxxx"
export TUNNEL_PORT="2222"

# --- TFE API access (run-test-workspace.sh, run-tf-demo-workspace-config.sh) --- #
# TFE_TOKEN is a user API token (User Settings > Tokens), not the IACT token.
export TFE_ORG="<your-tfe-organization>"       # must already exist; run-test-workspace.sh only
export TFE_TOKEN="<your-tfe-user-api-token>"
