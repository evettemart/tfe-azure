# ==============================================================================
# Environment Configuration Template
# Copy this file to .env (or .env.local) and populate with your values:
#   cp .env.local.example .env
#
# Load into your shell:
#   source .env   # or: export $(grep -v '^#' .env | xargs)
# ==============================================================================

# --- Release / Versioning --- #
MOD_RELEASE="0.0.0" # semver:major.minor.patch

# --- Azure Authentication Credentials (AzureRM Provider) --- #
export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
export ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"
export ARM_CLIENT_ID="00000000-0000-0000-0000-000000000000"
export ARM_CLIENT_SECRET="your-azure-service-principal-client-secret"
# export ARM_ENVIRONMENT="public" # or "usgovernment" for Azure GovCloud

# --- Windows Bastion Host Admin Password (Required if create_windows_bastion = true) --- #
# Must meet Azure complexity requirements (12+ chars, upper, lower, digit, special)
export TF_VAR_windows_bastion_admin_password="YourStrongPassword123!"

# --- Event Hub Connection String (Optional: required only if create_event_hub = false and log_fwd_destination_type is 'event_hub' or 'both') --- #
# export TF_VAR_event_hub_connection_string="Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=..."
